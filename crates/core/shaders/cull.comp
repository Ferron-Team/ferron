#version 460

// One invocation per (live instance, view): decide whether the instance is
// wanted by that view, and if it is, append its row to the view's list and count
// it into its batch's draw command.
//
// The two view kinds are not the same test and must not be made one. A frustum
// view -- the camera, and each face of a punctual light -- keeps a box that
// reaches into the volume it can see. A cascade keeps a box that reaches its
// volume *when swept toward the light*, which has no near plane at all: an
// object between the sun and the cascade is exactly what casts into it. Testing
// a cascade with its own six planes would drop those shadows, which is the
// mistake `systems::casts_into` documents on the CPU side.

layout(local_size_x = 64, local_size_y = 1) in;

const uint VIEW_FRUSTUM = 0;
const uint VIEW_CASCADE = 1;

struct Object {
    mat4 model;
    mat4 normal_matrix;
    mat4 prev_model;
};

struct Instance {
    uint row;
    // The batch's number, not its slot: the top bit says which pipeline variant
    // draws it and the rest is its index within that variant. `slot` below is
    // what turns the pair into a row of `commands`, and it cannot be resolved
    // on the host because the split moves whenever a new plain batch appears.
    // See `BatchIds` in `gfx/vulkan/cull.rs`.
    uint batch;
};

struct Batch {
    uint index_count;
    uint first_index;
    int vertex_offset;
    uint instance_base;
    // Written into the instance entry, because the draw that reads it has no
    // push constant of its own.
    uint material;
    // The mesh's own bounds, which every instance of the batch shares -- a
    // batch is one mesh. Held here rather than per instance because that is
    // where it is stored once instead of once per object, and because the model
    // matrix beside the object row is what turns it into a world box.
    vec4 bounds_min;
    vec4 bounds_max;
};

struct View {
    // World space into light space, for a cascade. Unused by a frustum view.
    mat4 light_view;
    vec4 planes[6];
    uint kind;
    float half_extent;
    float depth_range;
    // Where this view's block of `instance_index` begins.
    uint base;
};

struct DrawCommand {
    uint index_count;
    uint instance_count;
    uint first_index;
    int vertex_offset;
    uint first_instance;
};

layout(set = 0, binding = 0) readonly buffer Objects { Object objects[]; };
layout(set = 0, binding = 1) readonly buffer Instances { Instance instances[]; };
layout(set = 0, binding = 2) readonly buffer Batches { Batch batches[]; };
layout(set = 0, binding = 3) readonly buffer Views { View views[]; };
layout(set = 0, binding = 4) buffer Commands { DrawCommand commands[]; };
layout(set = 0, binding = 5) writeonly buffer Indices { uvec2 indices[]; };

layout(push_constant) uniform Push {
    uint instance_count;
    uint view_count;
    uint batch_count;
    // Where the masked batches begin, which is what a packed batch number is
    // resolved against.
    uint plain_count;
} push;

const uint MASKED_BIT = 0x80000000u;

// The row of `commands` a packed batch number owns this frame.
uint slot(uint packed) {
    uint index = packed & ~MASKED_BIT;
    return (packed & MASKED_BIT) != 0u ? push.plain_count + index : index;
}

// Conservative, exactly as `Frustum::intersects` is: true means "may be
// visible". `extents . |n|` is the box's support along the plane normal, so the
// box is rejected only when even its most inside corner is behind.
bool inside_frustum(View view, vec3 center, vec3 extents) {
    for (uint i = 0; i < 6; ++i) {
        vec4 plane = view.planes[i];
        if (dot(plane.xyz, center) + plane.w + dot(extents, abs(plane.xyz)) < 0.0) {
            return false;
        }
    }
    return true;
}

// The GPU half of `systems::casts_into`. `light_view` is a right-handed
// look-at, so the cascade lies at negative z between the eye at 0 and the far
// plane at -depth_range; the near side is deliberately open.
bool casts_into(View view, vec3 center, vec3 extents) {
    vec3 c = (view.light_view * vec4(center, 1.0)).xyz;
    mat3 rotation = mat3(view.light_view);
    vec3 ls = abs(rotation[0]) * extents.x + abs(rotation[1]) * extents.y + abs(rotation[2]) * extents.z;
    float half_extent = view.half_extent;
    return c.x - ls.x <= half_extent && c.x + ls.x >= -half_extent
        && c.y - ls.y <= half_extent && c.y + ls.y >= -half_extent
        && c.z + ls.z >= -view.depth_range;
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    uint view_index = gl_GlobalInvocationID.y;
    if (index >= push.instance_count || view_index >= push.view_count) {
        return;
    }

    Instance instance = instances[index];
    Object object = objects[instance.row];
    uint batch_slot = slot(instance.batch);
    Batch batch = batches[batch_slot];
    View view = views[view_index];

    vec3 bmin = batch.bounds_min.xyz;
    vec3 bmax = batch.bounds_max.xyz;
    // A mesh with no registered bounds is unmeasurable, so it is drawn rather
    // than culled -- the same fallback the CPU sweep takes, stated here because
    // the inverted box it arrives as would otherwise make a NaN centre and fail
    // every compare instead.
    bool measurable = all(lessThanEqual(bmin, bmax));

    bool wanted = true;
    if (measurable) {
        mat3 rotation = mat3(object.model);
        vec3 center = (object.model * vec4(0.5 * (bmin + bmax), 1.0)).xyz;
        vec3 half_extents = 0.5 * (bmax - bmin);
        vec3 extents = abs(rotation[0]) * half_extents.x
            + abs(rotation[1]) * half_extents.y
            + abs(rotation[2]) * half_extents.z;
        wanted = view.kind == VIEW_CASCADE
            ? casts_into(view, center, extents)
            : inside_frustum(view, center, extents);
    }
    if (!wanted) {
        return;
    }

    uint command = view_index * push.batch_count + batch_slot;
    uint offset = atomicAdd(commands[command].instance_count, 1);
    indices[view.base + batch.instance_base + offset] = uvec2(instance.row, batch.material);
}
