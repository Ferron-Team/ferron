#version 460

// A mip pyramid of the lit frame, for a *cone* to be sampled out of rather than
// a single texel.
//
// This is what makes a rough reflection affordable. The lobe a ray was sampled
// from has an angular width, so by the time the ray has travelled any distance
// it covers a patch of the world rather than a point — and reading one texel of
// that patch is precisely the variance that shows up as grain on everything
// that is not a mirror. Reading the level of this pyramid whose texel *is* the
// patch costs the same fetch and carries the average instead of a sample.
//
// Two passes build one of these, from the same source and to the same shape and
// both at half resolution: the reflection trace, whose rays are stochastic and
// denoised temporally anyway, and screen-space refraction, whose consumers are
// all rough enough to be averaging over a cone. The one thing that genuinely
// wants the frame sharp — a clear pane of glass — reads the frame itself rather
// than this chain, which is what lets this stay half. Neither pass owns this
// file, which is why it is not named for either.
//
// The tile shape is `hiz_build.comp`'s exactly: one workgroup owns a 64x64 tile
// and reduces it alone, because the render graph's unversioned resources forbid
// a pass per level. Only the reduction differs — a mean here, a minimum there.

const int MAX_LEVELS = 7;

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D u_source;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D u_mips[MAX_LEVELS];

layout(push_constant) uniform Push {
    // Extent of level 0, which is half the frame — the resolution the trace
    // works at, so a mirror loses nothing here it was not already losing.
    ivec2 extent;
    int levels;
} push;

shared vec4 lds[64];

// One bilinear fetch centred between four full-resolution texels averages them
// for free, which is exactly the 2:1 reduction level 0 is.
vec4 load(ivec2 p) {
    vec2 uv = (vec2(clamp(p, ivec2(0), push.extent - 1)) + 0.5) / vec2(push.extent);
    return texture(u_source, uv);
}

#define STORE(level, coord, value)                                \
    if (push.levels > (level)) {                                  \
        ivec2 size_ = imageSize(u_mips[level]);                   \
        if (all(lessThan(coord, size_))) {                        \
            imageStore(u_mips[level], coord, value);              \
        }                                                         \
    }

vec4 mean4(vec4 a, vec4 b, vec4 c, vec4 d) {
    return (a + b + c + d) * 0.25;
}

void main() {
    ivec2 tile = ivec2(gl_WorkGroupID.xy) * 64;
    ivec2 lid = ivec2(gl_LocalInvocationID.xy);
    ivec2 base = tile + lid * 8;

    // Levels 0 to 3 stream through in 2x2 blocks rather than being gathered
    // whole, and that shape is the difference between this pass costing what its
    // memory traffic costs and costing several times more.
    //
    // The obvious version keeps the thread's entire 8x8 sub-tile live — 64
    // `vec4`s, 256 32-bit registers — before reducing any of it. A GPU that
    // allots a thread around 128 spills the rest to device memory and then
    // reloads it, so a pass whose real work is one read and one write per texel
    // does several of each, and occupancy collapses on top of that. Reducing
    // each block the moment its four texels are in hand keeps at most a dozen
    // `vec4`s live and never spills.
    //
    // The reduction tree is unchanged, so every level is bit-identical to the
    // gathered version: `bi`/`bj` select the same 4x4 block the old `i`/`j` pair
    // did, and each level's store lands on the same coordinate.
    vec4 m2[4];
    for (int bj = 0; bj < 2; ++bj) {
        for (int bi = 0; bi < 2; ++bi) {
            vec4 m1[4];
            for (int j = 0; j < 2; ++j) {
                for (int i = 0; i < 2; ++i) {
                    ivec2 p = base + ivec2(bi * 4 + i * 2, bj * 4 + j * 2);
                    vec4 a = load(p);
                    vec4 b = load(p + ivec2(1, 0));
                    vec4 c = load(p + ivec2(0, 1));
                    vec4 d = load(p + ivec2(1, 1));
                    STORE(0, p, a)
                    STORE(0, p + ivec2(1, 0), b)
                    STORE(0, p + ivec2(0, 1), c)
                    STORE(0, p + ivec2(1, 1), d)

                    vec4 v = mean4(a, b, c, d);
                    STORE(1, p >> 1, v)
                    m1[j * 2 + i] = v;
                }
            }
            vec4 v = mean4(m1[0], m1[1], m1[2], m1[3]);
            STORE(2, (base >> 2) + ivec2(bi, bj), v)
            m2[bj * 2 + bi] = v;
        }
    }

    vec4 m3 = mean4(m2[0], m2[1], m2[2], m2[3]);
    STORE(3, (base >> 3) + ivec2(0, 0), m3)

    int slot = lid.y * 8 + lid.x;
    lds[slot] = m3;
    barrier();

    if ((lid.x & 1) == 0 && (lid.y & 1) == 0) {
        vec4 v = mean4(lds[slot], lds[slot + 1], lds[slot + 8], lds[slot + 9]);
        lds[slot] = v;
        STORE(4, ivec2(gl_WorkGroupID.xy) * 4 + (lid >> 1), v)
    }
    barrier();

    if ((lid.x & 3) == 0 && (lid.y & 3) == 0) {
        vec4 v = mean4(lds[slot], lds[slot + 2], lds[slot + 16], lds[slot + 18]);
        lds[slot] = v;
        STORE(5, ivec2(gl_WorkGroupID.xy) * 2 + (lid >> 2), v)
    }
    barrier();

    if (slot == 0) {
        vec4 v = mean4(lds[0], lds[4], lds[32], lds[36]);
        STORE(6, ivec2(gl_WorkGroupID.xy), v)
    }
}
